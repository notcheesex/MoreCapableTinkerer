<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>MoreCapableTinkerer</AssemblyName>
    <RootNamespace>MoreCapableTinkerer</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <OutputPath>../../1.6/Assemblies/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>

  <PropertyGroup>
    <RimWorldRoot Condition="'$(RimWorldRoot)' == ''">/mnt/c/Program Files (x86)/Steam/steamapps/common/RimWorld</RimWorldRoot>
    <RimWorldManagedDir Condition="'$(RimWorldManagedDir)' == ''">$(RimWorldRoot)/RimWorldWin64_Data/Managed</RimWorldManagedDir>
    <AssemblyCSharpDll Condition="'$(AssemblyCSharpDll)' == ''">$(RimWorldManagedDir)/Assembly-CSharp.dll</AssemblyCSharpDll>
    <UnityEngineDir Condition="'$(UnityEngineDir)' == ''">$(RimWorldManagedDir)</UnityEngineDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(AssemblyCSharpDll)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(UnityEngineDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(UnityEngineDir)/UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(UnityEngineDir)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
